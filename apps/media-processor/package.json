{
  "name": "@repo/media-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env=''",
    "cf-typegen": "wrangler types",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "lint": "wrangler types >/dev/null && oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit && tsc --noEmit -p test",
    "test": "wrangler types >/dev/null && vitest run",
    "test:toolbox": "cd container && npm ci && npm test",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf .wrangler"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@repo/constants": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  }
}
