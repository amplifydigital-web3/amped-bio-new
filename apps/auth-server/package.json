{
  "name": "@repo/auth-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx watch -r dotenv/config src/app.ts",
    "build": "tsc && ts-add-js-extension --dir=dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --exit-on-fatal-error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf coverage"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@repo/constants": "workspace:*",
    "@better-auth/cimd": "catalog:",
    "@better-auth/core": "1.7.5",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^1.3.3",
    "@noble/secp256k1": "^3.1.0",
    "@prisma/client": "6.7.0",
    "@react-email/components": "^0.0.36",
    "@react-email/render": "^1.0.6",
    "bcrypt": "^6.0.0",
    "better-auth": "catalog:",
    "better-call": "1.4.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "nodemailer": "^6.10.0",
    "prisma": "6.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "3.25.64"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "ts-add-js-extension": "^1.6.6",
    "tsx": "^4.19.4",
    "typescript": "5.9.2",
    "vitest": "^3.1.0"
  }
}