# Auth server configuration
#
# Variables marked REQUIRED have no default and the server refuses to boot
# without them. Their values differ per environment, so shipping a default
# would silently run the wrong config in another environment.
#
# Variables with defaults are safe to omit: their default is valid in every
# environment (feature toggles, optional integration credentials, ...).
#
# See src/env.ts for the full schema.

# ---------- Runtime ----------
# REQUIRED. One of: development | staging | production | testing
APP_ENV=development
# Optional. Defaults to 44000.
PORT=44000

# ---------- Database ----------
# REQUIRED.
DATABASE_URL="mysql://amped_user:amped_password@localhost:23306/amped_bio"

# ---------- Better Auth ----------
# REQUIRED. Any random string of at least 16 characters. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# REQUIRED. Public origin of the auth subdomain, e.g. https://auth.amped.bio
BETTER_AUTH_URL=http://localhost:44000

# ---------- JWT ----------
# REQUIRED. RSA private key in PEM/PKCS8 format. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# Store the whole key including the BEGIN/END lines, with newlines escaped as \n.
JWT_PRIVATE_KEY=your-jwt-private-key-here
# REQUIRED. Audience claim of the JWT signed for Web3Auth. The verifier
# compares this value literally against the `aud` of the token, so it must be
# the full auth origin, identical to BETTER_AUTH_URL. A bare domain
# (staging.amped.bio) is rejected even though the token is otherwise valid.
# Production: https://auth.amped.bio
JWT_AUDIENCE=https://auth.amped.bio

# ---------- OAuth 2.1 / OIDC provider ----------
# REQUIRED. Canonical protected resource identifier of the MCP server (HTTPS, no query).
# Served by apps/server, so it must match MCP_RESOURCE_URL in apps/server/.env.
MCP_RESOURCE_URL=http://localhost:24300/mcp
# Optional. Comma separated list of first-party OAuth client ids that skip consent.
OAUTH_TRUSTED_CLIENT_IDS=
# REQUIRED. Origins allowed to call this server and to be redirected to during OAuth.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# REQUIRED. Shared cookie domain so the session spans subdomains. Empty is a
# valid value when the frontends share a host (localhost); set it explicitly.
COOKIE_DOMAIN=

# ---------- App URLs ----------
# REQUIRED. Frontends this server trusts and redirects back to.
APP_URL=http://localhost:5173
LANDINGPAGE_URL=http://localhost:3000

# ---------- Google OAuth (social login, optional) ----------
# Optional. Leave empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- CAPTCHA ----------
# REQUIRED. The captcha plugin is always active; without these the auth
# endpoints fail with MISSING_SECRET_KEY.
CAPTCHA_SERVER_URL=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ---------- SMTP ----------
# REQUIRED. Host and port of the SMTP relay (MailDev locally, real SMTP in prod).
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional. Accepts true/t/1 and false/f/0. Defaults to false.
SMTP_SECURE=false
# Optional. Empty means unauthenticated relay (MailDev).
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to noreply@amped.bio.
SMTP_FROM_EMAIL=noreply@amped.bio

# ---------- Staging example ----------
# APP_ENV=staging
# DATABASE_URL="mysql://user:password@host:3306/amped_bio"
# BETTER_AUTH_URL=https://auth.staging.amped.bio
# APP_URL=https://app.staging.amped.bio
# LANDINGPAGE_URL=https://staging.amped.bio
# COOKIE_DOMAIN=.staging.amped.bio
# CORS_ORIGINS=https://app.staging.amped.bio,https://staging.amped.bio
# MCP_RESOURCE_URL=https://api.staging.amped.bio/mcp
# JWT_AUDIENCE=https://auth.staging.amped.bio

# ---------- Production example ----------
# APP_ENV=production
# DATABASE_URL="mysql://user:password@host:3306/amped_bio"
# BETTER_AUTH_URL=https://auth.amped.bio
# APP_URL=https://app.amped.bio
# LANDINGPAGE_URL=https://amped.bio
# COOKIE_DOMAIN=.amped.bio
# CORS_ORIGINS=https://app.amped.bio,https://amped.bio,https://landingpage.amped.bio
# MCP_RESOURCE_URL=https://api.amped.bio/mcp
# JWT_AUDIENCE=https://auth.amped.bio
