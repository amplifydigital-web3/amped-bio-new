# Server configuration
APP_ENV=development
PORT=24300
DATABASE_URL="mysql://amped_user:amped_password@localhost:23306/amped_bio"

JWT_PRIVATE_KEY=your-jwt-private-key-here

# Wallet configuration (optional)
# FAUCET_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
FAUCET_AMOUNT=0.001
FAUCET_MOCK_MODE=true

# Affiliate Rewards Configuration
# AFFILIATES_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# Note: SimpleBatchSend contract address is configured in chain config (packages/web3/src/index.ts)
# Affiliate rewards are sent on Libertas Testnet (chain ID: 73863)

# SMTP Configuration
# For local development with MailDev
SMTP_HOST=localhost
SMTP_PORT=20250
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@amped.bio

# Staging and production: SMTP2GO
# Settings from the SMTP2GO dashboard (Sending > SMTP Users). Use an SMTP user,
# not the account login. Port 2525 or 587 with SMTP_SECURE=false (STARTTLS);
# port 465 needs SMTP_SECURE=true. The sender domain must be verified in
# SMTP2GO (Sending > Verified Senders) so SPF and DKIM pass.
# Check with: pnpm run --filter server email:check you@amped.bio
# SMTP_HOST=mail.smtp2go.com
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=<smtp2go smtp user>
# SMTP_PASSWORD=<smtp2go smtp password>
# SMTP_FROM_EMAIL=noreply@amped.bio

# Deployment
APP_URL=http://localhost:5173
# APP_URL=https://app.amped.bio
# The landing page origin is the `aud` of the wallet token handed to Web3Auth, so
# the verifier must be configured with the same value: https://amped.bio in
# production, https://staging.amped.bio in staging. Verification and password
# reset email links also point here (the /auth pages live on the landing page).
LANDINGPAGE_URL=http://localhost:3000
# LANDINGPAGE_URL=https://amped.bio
COOKIE_DOMAIN=
# COOKIE_DOMAIN=.amped.bio
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://app.amped.bio,https://amped.bio,https://landingpage.amped.bio
API_HOST=localhost:24300
# API_HOST=api.amped.bio

# How many proxies (or which addresses) sit in front of the server. Express uses
# this to derive req.ip safely from X-Forwarded-For, which analytics relies on
# for rate limiting and visitor hashing. Accepts a hop count ("1"), "loopback",
# a subnet ("10.0.0.0/8") or a comma-separated list. Leave empty when the server
# is reached directly. Example behind a single edge proxy:
# TRUST_PROXY=1

# For staging
# APP_URL=https://app.staging.amped.bio
# LANDINGPAGE_URL=https://staging.amped.bio
# COOKIE_DOMAIN=.staging.amped.bio
# CORS_ORIGINS=https://app.staging.amped.bio,https://staging.amped.bio
# API_HOST=api.staging.amped.bio

# Storage Configuration
# For local development with S3Mock
AWS_REGION=local
AWS_ACCESS_KEY_ID=S3RVER
AWS_SECRET_ACCESS_KEY=S3RVER
AWS_S3_BUCKET_NAME=amped-bio
AWS_S3_ENDPOINT=http://localhost:29090
AWS_S3_PUBLIC_URL=http://localhost:29090/amped-bio

# For production with AWS S3
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET_NAME=amped-bio
# AWS_S3_PUBLIC_URL=https://your-cdn-or-bucket-url.com

# Self-hosted Cap captcha (https://captcha.amped.bio)
CAPTCHA_SERVER_URL=https://captcha.amped.bio
CAPTCHA_SITE_KEY=6ce5d95dbc
CAPTCHA_SECRET_KEY=your_cap_secret_key_here

GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
 
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=

# Redis Configuration
# Redis is optional. If REDIS_HOST is set, Redis will be used.
# If not set or connection fails, fallbacks to in-memory cache.
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=
REDIS_TLS=false

# Creator Pool Broadcast (Build Board #1). While true, only pool owners an
# admin has invited (Admin, Broadcasts, Pilot senders) can send. Unset, it is
# true when APP_ENV=production and false otherwise (staging tests sends).
BROADCAST_INVITE_ONLY=true

SUBGRAPH_URL=https://graph-q101yuw854jc2su8q4h83f1b.groundhog.revoscan.io/subgraphs/name/uat/revonames

AUTHBASE_BASE_URL=https://api-uat.authbase.io
AUTHBASE_API_KEY=
AUTHBASE_API_SECRET=
# Screen Review 109: show the Verified chip and check dates on public pages
RNS_PUBLIC_IDENTITY=false
# Screen Review 079 D2: show a Verified owner's shared attributes on name pages.
# Keep false until the Privacy Policy says others can see them.
RNS_PUBLIC_ATTRIBUTES=false
# OAuth 2.1 / OIDC provider ("Sign in with Amped.bio")
# Public origin of the auth server (apps/auth-server), used as the issuer. Required.
BETTER_AUTH_URL=http://localhost:44000
# BETTER_AUTH_URL=https://auth.amped.bio
# BETTER_AUTH_URL=https://auth.staging.amped.bio
# Canonical protected resource identifier of the MCP server (HTTPS, no query). Required.
MCP_RESOURCE_URL=http://localhost:24300/mcp
# MCP_RESOURCE_URL=https://api.amped.bio/mcp
# MCP_RESOURCE_URL=https://api.staging.amped.bio/mcp
# Comma separated list of first-party OAuth client ids that skip consent.
OAUTH_TRUSTED_CLIENT_IDS=

# Messaging on Telegram (Build Board #2). Real values live in the secret store, never here.
# Master switch for the webhook and the sender loop. Keep false until the bot exists.
TELEGRAM_ENABLED=false
# Token from BotFather. The bot username is resolved from the token through the
# Bot API getMe(); set TELEGRAM_BOT_USERNAME only as an override for tests.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=  # optional override; resolved from the token via getMe() otherwise
# Passed as secret_token to setWebhook; the webhook route rejects requests without it
TELEGRAM_WEBHOOK_SECRET=
# Log In with Telegram (OIDC) credentials from BotFather, Login Widget
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Encrypts Telegram usernames and names at rest. Falls back to BETTER_AUTH_SECRET.
TELEGRAM_SECRET_BOX_KEY=
# Phase 1 pilot: only invited creators can turn on Fan messages
MESSAGING_INVITE_ONLY=true
# Phase 2: gated creator groups
TELEGRAM_GROUPS=false

# USDC in the wallet (Build Board #29). Real values live in the secret store, never here.
# Master switch for gasless sends and the indexer. Keep false until the CDP relayer account exists.
USDC_ENABLED=false
# base in production, base-sepolia everywhere else
PAYMENT_CHAIN=base-sepolia
# CDP Node RPC for Base in production; empty uses the public endpoint
BASE_RPC_URL=
# CDP Server Wallet relayer (docs/ops/cdp-policy.md)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_RELAYER_ACCOUNT=
RELAYER_GAS_ALARM_ETH=0.05
RELAYER_GAS_STOP_ETH=0.01
# Screening: Circle Compliance Engine when granted, Chainalysis oracle on Base mainnet only
CIRCLE_API_KEY=
CIRCLE_SCREENING_CHAIN=ETH
CHAINALYSIS_ORACLE=
# Staging only: comma separated test addresses that are always refused
USDC_SCREEN_DENYLIST=
# Defaults to true in production and false elsewhere
# USDC_SCREENING_REQUIRED=true
# Content system (Build Board #20). Real values live in the secret store, never here.
# Setup steps: docs/fixes/content-foundation.md section 5. Keep false until they are done.
CONTENT_UPLOADS_ENABLED=false
# Cloudflare account (staging runs on its own account so Stream webhooks do not collide)
CF_ACCOUNT_ID=
# R2 API token, Object Read and Write on R2_BUCKET only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=amped-content-staging
# Stream: API token (Stream Edit), signing key id and PEM, webhook secret
CF_STREAM_API_TOKEN=
CF_STREAM_KEY_ID=
CF_STREAM_KEY_PEM=
CF_STREAM_WEBHOOK_SECRET=
# Hostnames Stream plays on, comma separated
CF_STREAM_ALLOWED_ORIGINS=staging.amped.bio,app.staging.amped.bio
# Media gateway Worker origin (PR 3)
MEDIA_GATEWAY_ORIGIN=https://media.ampedusercontent-staging.com
# kid:base64urlSecret pairs, comma separated; first signs. Generate: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
MEDIA_TOKEN_KEYS=
# Shared with the processor Worker (PR 4)
CONTENT_PROCESSOR_SECRET=
# Per kind upload limits (MB) and the default quota
UPLOAD_LIMIT_CONTENT_VIDEO_MB=2048
UPLOAD_LIMIT_CONTENT_AUDIO_MB=500
UPLOAD_LIMIT_CONTENT_IMAGE_MB=25
UPLOAD_LIMIT_CONTENT_DOCUMENT_MB=100
UPLOAD_LIMIT_CONTENT_FILE_MB=500
CONTENT_QUOTA_DEFAULT_MB=5120
CONTENT_QUOTA_VIDEO_MINUTES=300

