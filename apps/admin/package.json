    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.1",
    "react-hot-toast": "^2.5.2",
    "react-router": "^7.11.0",
    "sonner": "^2.0.7",
    "viem": "2.34.0",
    "wagmi": "2.14.8",
    "zod": "^3.25.64",
    "@hookform/resolvers": "^3.9.1",
    "@repo/web3": "workspace:*",
    "@trpc/client": "11.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
