{
  "name": "@repo/web3",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --external viem && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format esm,cjs --watch --external viem --onSuccess \"tsc --emitDeclarationOnly\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf coverage",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "dependencies": {
    "tsup": "^8.0.0",
    "viem": "2.34.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
