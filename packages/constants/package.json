{
  "name": "@repo/constants",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --external zod && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format esm,cjs --watch --onSuccess \"tsc --emitDeclarationOnly\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm --filter @repo/client exec vitest run --root ../../packages/constants",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf coverage",
    "prepare": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "3.25.64",
    "yaml": "^2.5.0"
  }
}
