
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  revo_name      String?
  email          String
  email_verified Boolean   @default(false) @map("email_verified")
  password       String?
  image          String?   @db.LongText // Keep for backward compatibility
  handle         String?   @unique @map("littlelink_name")
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  sessions       Session[]
  accounts       Account[]

  description        String? @map("littlelink_description") @db.LongText
  role               String  @default("user")
  block              String  @default("no")
  theme              String?
  image_file_id      Int?
  reward_business_id String?

  themes            Theme[]
  blocks            Block[]
  confirmationCodes ConfirmationCode[]
  uploadedFiles     UploadedFile[]
  profileImage      UploadedFile?      @relation("UserProfileImage", fields: [image_file_id], references: [id], onDelete: SetNull)

  wallet            UserWallet?
  referralsMade     Referral[]  @relation("ReferrerReferrals")
  referralsReceived Referral[]  @relation("ReferredReferrals")
  twoFactorEnabled  Boolean     @default(false) @map("two_factor_enabled")
  twoFactor         TwoFactor?

  oauthClients      OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents     OauthConsent[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@map("session")
  @@index([userId])
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.LongText
  refreshToken          String?
  idToken               String?   @db.LongText
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
  @@index([userId])
}

model Verification {
  id         Int       @id @default(autoincrement())
  identifier String
  value      String    @db.LongText
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@index([identifier(length: 191)])
}

model ThemeCategory {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  title         String
  category      String
  description   String?
  visible       Boolean   @default(false)
  image_file_id Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt

  themes        Theme[]
  categoryImage UploadedFile? @relation("ThemeCategoryImage", fields: [image_file_id], references: [id], onDelete: SetNull)

  @@map("theme_categories")
}

model Theme {
  id                Int       @id @default(autoincrement())
  user_id           Int? // if it is null it is a system theme
  share_level       String    @default("private")
  share_config      Json?
  name              String?
  description       String?   @db.LongText
  config            Json?
  category_id       Int?
  thumbnail_file_id Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt

  user           User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category       ThemeCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  thumbnailImage UploadedFile?  @relation("ThemeThumbnailImage", fields: [thumbnail_file_id], references: [id], onDelete: SetNull)

  @@map("themes")
}

model Block {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String    @db.VarChar(255)
  order      Int       @default(0)
  clicks     Int       @default(0)
  config     Json?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("blocks")
}

model ConfirmationCode {
  id        Int                  @id @default(autoincrement())
  code      String               @db.Char(6)
  type      ConfirmationCodeType
  userId    Int
  used      Boolean              @default(false)
  expiresAt DateTime
  createdAt DateTime             @default(now())
  updatedAt DateTime?            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("confirmation_codes")
}

enum ConfirmationCodeType {
  EMAIL_CONFIRMATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum FileStatus {
  PENDING
  COMPLETED
  DELETED
}

model UploadedFile {
  id                  Int             @id @default(autoincrement())
  s3_key              String          @db.VarChar(255)
  bucket              String          @db.VarChar(100)
  file_name           String          @db.VarChar(255)
  file_type           String?         @db.VarChar(100)
  size                BigInt?
  user_id             Int? // Nullable for admin/server files
  status              FileStatus      @default(PENDING)
  uploaded_at         DateTime        @default(now())
  created_at          DateTime        @default(now())
  updated_at          DateTime?       @updatedAt
  user                User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  userProfileImage    User[]          @relation("UserProfileImage")
  themeCategoryImage  ThemeCategory[] @relation("ThemeCategoryImage")
  themeThumbnailImage Theme[]         @relation("ThemeThumbnailImage")
  creatorPoolImage    CreatorPool[]   @relation("CreatorPoolImage")

  @@index([s3_key])
  @@index([user_id])
  @@index([status])
  @@map("uploaded_files")
}

model UserWallet {
  id                   Int           @id @default(autoincrement())
  address              String        @unique
  userId               Int           @unique // Ensure one-to-one relationship
  last_airdrop_request DateTime?
  created_at           DateTime      @default(now())
  updated_at           DateTime?     @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorPools         CreatorPool[]
  stakedPools          StakedPool[]
  stakeEvents          StakeEvent[]

  @@map("user_wallets")
}

model CreatorPool {
  id       Int    @id @default(autoincrement())
  walletId Int
  chainId  String

  name          String?       @db.VarChar(255)
  image_file_id Int?
  description   String?       @db.LongText
  fans          Int           @default(0)
  revoStaked    String        @db.Text
  poolAddress   String?       @unique
  creationTxid  String?       @db.VarChar(66)
  wallet        UserWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  poolImage     UploadedFile? @relation("CreatorPoolImage", fields: [image_file_id], references: [id], onDelete: SetNull)
  stakedPools   StakedPool[]
  stakeEvents   StakeEvent[]
  hidden        Boolean?      @default(false)

  @@unique([walletId, chainId])
  @@map("creator_pools")
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model SiteSettings {
  setting_key   String           @id
  setting_value String           @db.LongText
  value_type    SettingValueType

  @@map("site_settings")
}

model StakedPool {
  id           Int       @id @default(autoincrement())
  userWalletId Int
  poolId       Int
  stakeAmount  String    @db.Text // Using Text to handle potentially very large stake amounts
  lastClaim    DateTime? // Timestamp of the last reward claim
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  userWallet UserWallet  @relation(fields: [userWalletId], references: [id], onDelete: Cascade)
  pool       CreatorPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  // Each wallet can only have one staking entry per pool
  @@unique([userWalletId, poolId])
  @@map("staked_pools")
}

model StakeEvent {
  id              Int      @id @default(autoincrement())
  userWalletId    Int
  poolId          Int
  amount          String   @db.Text // The amount of tokens staked or unstaked (positive for stake, negative for unstake)
  eventType       String // "stake" or "unstake"
  transactionHash String // Transaction hash for verification
  createdAt       DateTime @default(now())

  userWallet UserWallet  @relation(fields: [userWalletId], references: [id], onDelete: Cascade)
  pool       CreatorPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([transactionHash, userWalletId, poolId])
  @@map("stake_events")
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int      @map("referrer_id")
  referredId Int      @map("referred_id")
  txid       String?  @map("txid") @db.Text
  createdAt  DateTime @default(now())

  referrer User @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredReferrals", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@index([createdAt])
  @@map("referrals")
}

model Jwks {
  id         Int       @id @default(autoincrement())
  publicKey  String    @db.LongText
  privateKey String    @db.LongText
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model NdauConversion {
  id                  Int       @id @default(autoincrement())
  ndau_address        String    @db.VarChar(255)
  ndau_amount         String    @db.Text
  revo_amount         String    @db.Text
  revo_address        String    @db.VarChar(255)
  ampedbio_signature  String    @db.Text
  ndau_signature      String    @db.Text
  ndau_validation_key String    @db.Text
  txid                String?   @db.Text
  status              String    @default("pending")
  group               String    @default("gn") @db.VarChar(10)
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt
  document_hash       String    @map("document_hash") @db.VarChar(255)
  timestamp           Int

  @@unique([ndau_address])
  @@index([status])
  @@index([created_at])
  @@map("ndau_conversions")
}

model TwoFactor {
  id                     String  @id @default(cuid())
  userId                 Int     @map("user_id")
  secret                 String  @db.Text
  backupCodes            String  @map("backup_codes") @db.Text
  verified               Boolean @default(false)
  failedVerificationCount Int?   @default(0) @map("failed_verification_count")
  lockedUntil            DateTime? @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("two_factor")
  @@index([secret(length: 191)])
}

// ===== OAuth 2.1 provider (Better Auth oauth-provider / MCP plugins) =====
// Multi-value fields are stored as JSON strings because MySQL has no array type
// and the adapter serializes `string[]` fields when `supportsArrays` is false.

model OauthClient {
  id                               Bytes     @id @db.Binary(16)
  clientId                         String    @unique @map("client_id") @db.VarChar(255)
  clientSecret                     String?   @map("client_secret") @db.Text
  clientDiscoveryId                String?   @map("client_discovery_id")
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?  @map("skip_consent")
  enableEndSession                 Boolean?  @map("enable_end_session")
  subjectType                      String?   @map("subject_type")
  scopes                           String?   @db.Text
  clientCredentialsScopes          String?   @map("client_credentials_scopes") @db.Text
  userId                           Int?      @map("user_id")
  createdAt                        DateTime? @map("created_at")
  updatedAt                        DateTime? @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?   @db.Text
  contacts                         String?   @db.Text
  tos                              String?
  policy                           String?
  softwareId                       String?   @map("software_id")
  softwareVersion                  String?   @map("software_version")
  softwareStatement                String?   @map("software_statement") @db.Text
  redirectUris                     String    @map("redirect_uris") @db.Text
  postLogoutRedirectUris           String?   @map("post_logout_redirect_uris") @db.Text
  backchannelLogoutUri             String?   @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?  @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?   @map("token_endpoint_auth_method")
  applicationType                  String?   @map("application_type")
  jwks                             String?   @db.Text
  jwksUri                          String?   @map("jwks_uri")
  grantTypes                       String?   @map("grant_types") @db.Text
  responseTypes                    String?   @map("response_types") @db.Text
  requirePKCE                      Boolean?  @map("require_pkce")
  dpopBoundAccessTokens            Boolean?  @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?   @map("reference_id")
  metadata                         Json?

  user            User?                 @relation(fields: [userId], references: [id])
  refreshTokens   OauthRefreshToken[]
  accessTokens    OauthAccessToken[]
  consents        OauthConsent[]
  clientResources OauthClientResource[]

  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                          Bytes     @id @db.Binary(16)
  identifier                  String    @unique @db.VarChar(255)
  name                        String
  accessTokenTtl              Int?      @map("access_token_ttl")
  refreshTokenTtl             Int?      @map("refresh_token_ttl")
  signingAlgorithm            String?   @map("signing_algorithm")
  signingKeyId                String?   @map("signing_key_id")
  allowedScopes               String?   @map("allowed_scopes") @db.Text
  customClaims                Json?     @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean? @default(false) @map("dpop_bound_access_tokens_required")
  disabled                    Boolean?  @default(false)
  createdAt                   DateTime? @map("created_at")
  updatedAt                   DateTime? @map("updated_at")
  policyVersion               Int?      @default(1) @map("policy_version")
  metadata                    Json?

  clientResources OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         Bytes     @id @db.Binary(16)
  clientId   String    @map("client_id") @db.VarChar(255)
  resourceId String    @map("resource_id") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime? @map("created_at")

  client   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                     Bytes     @id @db.Binary(16)
  token                  String    @unique @db.VarChar(255)
  clientId               String    @map("client_id") @db.VarChar(255)
  sessionId              Int?      @map("session_id")
  userId                 Int       @map("user_id")
  referenceId            String?   @map("reference_id")
  authorizationCodeId    String?   @map("authorization_code_id") @db.VarChar(255)
  resources              String?   @db.Text
  requestedUserInfoClaims String?  @map("requested_user_info_claims") @db.Text
  scopes                 String    @db.Text
  expiresAt              DateTime  @map("expires_at")
  createdAt              DateTime  @map("created_at")
  revoked                DateTime?
  rotatedAt              DateTime? @map("rotated_at")
  rotationReplayResponse String?   @map("rotation_replay_response") @db.Text
  rotationReplayExpiresAt DateTime? @map("rotation_replay_expires_at")
  authTime               DateTime? @map("auth_time")
  confirmation           Json?

  client      OauthClient       @relation(fields: [clientId], references: [clientId])
  session     Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user        User              @relation(fields: [userId], references: [id])
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                     Bytes     @id @db.Binary(16)
  token                  String    @unique @db.VarChar(255)
  clientId               String    @map("client_id") @db.VarChar(255)
  sessionId              Int?      @map("session_id")
  userId                 Int?      @map("user_id")
  referenceId            String?   @map("reference_id")
  authorizationCodeId    String?   @map("authorization_code_id") @db.VarChar(255)
  resources              String?   @db.Text
  requestedUserInfoClaims String?  @map("requested_user_info_claims") @db.Text
  refreshId              Bytes?    @map("refresh_id")
  scopes                 String    @db.Text
  expiresAt              DateTime  @map("expires_at")
  createdAt              DateTime  @map("created_at")
  revoked                DateTime?
  confirmation           Json?

  client   OauthClient        @relation(fields: [clientId], references: [clientId])
  session  Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user     User?              @relation(fields: [userId], references: [id])
  refresh  OauthRefreshToken? @relation(fields: [refreshId], references: [id])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([authorizationCodeId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                     Bytes     @id @db.Binary(16)
  clientId               String    @map("client_id") @db.VarChar(255)
  userId                 Int?      @map("user_id")
  referenceId            String?   @map("reference_id")
  resources              String?   @db.Text
  requestedUserInfoClaims String?  @map("requested_user_info_claims") @db.Text
  scopes                 String    @db.Text
  createdAt              DateTime  @map("created_at")
  updatedAt              DateTime  @map("updated_at")

  client OauthClient @relation(fields: [clientId], references: [clientId])
  user   User?       @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        Bytes    @id @db.Binary(16)
  expiresAt DateTime @map("expires_at")

  @@map("oauth_client_assertion")
}

model DeviceCode {
  id               Bytes     @id @db.Binary(16)
  deviceCode       String    @unique @map("device_code") @db.VarChar(255)
  userCode         String    @map("user_code") @db.VarChar(255)
  userId           String?   @map("user_id") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at")
  status           String
  lastPolledAt     DateTime? @map("last_polled_at")
  pollingInterval  Int?      @map("polling_interval")
  clientId         String?   @map("client_id") @db.VarChar(255)
  scope            String?   @db.Text
  resources        String?   @db.Text
  oauthClientId    String?   @map("oauth_client_id") @db.VarChar(255)

  @@index([clientId])
  @@map("device_code")
}
